# =====================================================================
# Konfigurasi GoWA Dashboard standalone
# =====================================================================
# File ini disalin ke /opt/gowa-dashboard/.env saat install dan TIDAK
# pernah ditimpa oleh install ulang / upgrade.
#
# Setelah mengubah file ini, restart service:
#   sudo systemctl restart gowa-dashboard

# --- Server dashboard ------------------------------------------------
# Bind ke loopback saja: akses publik lewat reverse proxy nginx aaPanel.
# Ubah ke 0.0.0.0 HANYA kalau memang mau diakses langsung tanpa nginx
# (tidak disarankan — tidak ada HTTPS).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=18088

# Path file database SQLite (jadwal, broadcast, log, setting koneksi core).
DASHBOARD_DB=/opt/gowa-dashboard/data/dashboard.db

# Login dashboard (Basic Auth). Format "user:password". Kosong = TERBUKA.
#
# install.sh MENGISI baris ini otomatis saat instalasi baru:
#   - kalau GOWA_BASIC_AUTH=user:pass diberikan  -> dipakai apa adanya
#   - kalau dijalankan di terminal                -> ditanyakan interaktif
#   - kalau tidak keduanya                        -> password kuat dibuat
#                                                    otomatis & ditampilkan
#                                                    sekali di akhir install
#   - kalau GOWA_BASIC_AUTH=none                  -> sengaja dibiarkan kosong
#
# Jadi biasanya Anda tidak perlu mengedit baris ini secara manual. Kalau mau
# ganti password: ubah di sini lalu `systemctl restart gowa-dashboard`.
#
# Password boleh memuat ':' (pemisah hanya ':' pertama), username tidak boleh.
DASHBOARD_BASIC_AUTH=

# --- Koneksi ke gowa-core --------------------------------------------
# CATATAN PENTING: tiga nilai di bawah hanya dipakai sebagai NILAI AWAL
# saat pertama kali boot (database masih kosong). Setelah itu, atur lewat
# UI: tab "Pengaturan" di dashboard -> Core URL + credential -> Simpan.
# Nilai dari UI tersimpan di database dan MENANG atas file ini.
#
# Jadi Anda tidak wajib mengisi di sini — biarkan default lalu isi lewat UI.
#
# Core bisa di server mana saja, contoh:
#   http://127.0.0.1:3000          (core di server yang sama)
#   https://api.domainku.com       (core di server lain / di balik domain)
WHATSAPP_API_URL=http://127.0.0.1:3000
WHATSAPP_API_USER=
WHATSAPP_API_PASSWORD=

# --- Timezone --------------------------------------------------------
# Zona waktu default untuk jadwal baru. IANA name, mis. Asia/Jakarta.
DASHBOARD_TZ=Asia/Jakarta

# --- Auto cleanup log ------------------------------------------------
# Hapus otomatis schedule_logs & broadcast selesai yang lebih tua dari
# N hari. 0 = matikan auto-cleanup.
DASHBOARD_LOG_RETENTION_DAYS=30
DASHBOARD_CLEANUP_INTERVAL_HOURS=6
